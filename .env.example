# Copy to .env.local. Unset values fall back to production (src/lib/config.ts).

# Public URL of the API, used by the browser (baked in at build time).
# Local API (../assisteai-api): use `localhost`, not 127.0.0.1, so the session cookie is same-site with the front.
NEXT_PUBLIC_API_URL=http://localhost:3000

# URL the Next.js server uses to reach the API (server-side fetches). Defaults to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=

# Google OAuth client: the same one the API checks as the ID token's `aud`.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=736877274011-im98og8tkedl1gdtvjrj6u217dpqf9rq.apps.googleusercontent.com
